# Copy this file to ".env" and fill in your own values. Never commit ".env".

# PostgreSQL connection (user:password@host:port/database)
DATABASE_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD@localhost:5432/datheon

# Email alerts (Gmail example: use an "App Password", not your normal password)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
EMAIL_SENDER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
EMAIL_RECEIVER=your_email@gmail.com

# Daily run time for the scheduler (24h format)
RUN_TIME=09:00
